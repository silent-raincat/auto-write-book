# ==================================
# AI Novel Writing System - Environment Variables
# ==================================

# Database Configuration
# Choose: 'sqlite' for local development, 'supabase' for cloud deployment
DB_TYPE=sqlite

# ==================================
# Supabase Configuration (for cloud deployment)
# ==================================
# Get these from your Supabase project settings
# https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==================================
# Server Configuration
# ==================================
PORT=3002
NODE_ENV=development

# ==================================
# ModelScope AI Configuration
# ==================================
# Default API key (optional, can be set by users in profile)
MODELSCOPE_API_KEY=ms-54964895-9e08-409e-80ab-fe3709c1b1e0

# ==================================
# Test User (for local development)
# ==================================
# Default test user ID for local SQLite mode
TEST_USER_ID=00000000-0000-0000-0000-000000000000
