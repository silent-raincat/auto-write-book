{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:prod",
    "watchPatterns": [
      "src/**",
      "api/**"
    ]
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "healthcheckPath": "/api/health",
    "readinessProbe": {
      "httpPath": "/api/health"
    },
    "restartPolicyType": "ON_FAILURE"
  }
}
